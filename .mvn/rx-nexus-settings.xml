<?xml version="1.0" encoding="UTF-8"?>
<!--
	RxLogix Nexus: configured from the environment so no credentials live in the repo
	(same NEXUS_* variables as the spring-framework and spring-security forks).

	Pass it as *global* settings so ~/.m2/settings.xml (mirrors, servers) still applies:

	./mvnw -gs .mvn/rx-nexus-settings.xml deploy -DskipTests -Ddisable.checks=true

	Releases (4.3.3-rxlogix-N) go to NEXUS_URL. -SNAPSHOT versions still follow
	.mvn/maven.config (altSnapshotDeploymentRepository) unless overridden on the command line.
-->
<settings>
	<servers>
		<server>
			<id>rx-nexus</id>
			<username>${env.NEXUS_USERNAME}</username>
			<password>${env.NEXUS_PASSWORD}</password>
		</server>
	</servers>
	<profiles>
		<profile>
			<id>rx-nexus</id>
			<properties>
				<!-- id::layout::url form: some modules (spring-cloud-commons-dependencies) use
					maven-deploy-plugin 2.7, which only knows altDeploymentRepository -->
				<altDeploymentRepository>rx-nexus::default::${env.NEXUS_URL}</altDeploymentRepository>
				<altReleaseDeploymentRepository>rx-nexus::default::${env.NEXUS_URL}</altReleaseDeploymentRepository>
			</properties>
		</profile>
	</profiles>
	<activeProfiles>
		<activeProfile>rx-nexus</activeProfile>
	</activeProfiles>
</settings>
